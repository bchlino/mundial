rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } // Simplified for now as some emails might not be verified but Google login usually is. Actually instructions say strictly mandate email_verified == true.
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    // DEBUG MODE: keep false in production.
    function debugMode() { return false; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100;
    }
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt']);
    }

    // Teams (Global)
    match /teams/{teamId} {
      allow read: if isSignedIn();
    }

    // Leagues
    function isValidLeague(data) {
      return data.keys().hasAll(['name', 'adminId', 'status']) &&
             data.name is string && data.name.size() <= 100 &&
             data.adminId is string &&
             data.status in ['setup', 'drafting', 'active', 'completed'];
    }
    function isLeagueAdmin(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data.adminId == request.auth.uid;
    }
    function isLeagueMemberData(data) {
      return data.participants != null &&
             data.participants is list &&
             data.participants.hasAny([request.auth.uid]);
    }
    function isLeagueMember(leagueId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/leagues/$(leagueId)) &&
             isLeagueMemberData(get(/databases/$(database)/documents/leagues/$(leagueId)).data);
    }
    function isSelfJoinParticipantsUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['participants']) &&
             incoming().participants is list &&
             incoming().participants.hasAll(existing().participants) &&
             incoming().participants.hasAny([request.auth.uid]) &&
             (
               (existing().participants.hasAny([request.auth.uid]) && incoming().participants.size() == existing().participants.size()) ||
               (!existing().participants.hasAny([request.auth.uid]) && incoming().participants.size() == existing().participants.size() + 1)
             );
    }
    function isValidJoinRequestCreate(userId) {
      return incoming().keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'status', 'createdAt', 'updatedAt']) &&
             incoming().uid == userId &&
             incoming().status == 'pending' &&
             (!('email' in incoming()) || incoming().email == null || incoming().email is string) &&
             (!('displayName' in incoming()) || incoming().displayName == null || incoming().displayName is string) &&
             (!('photoURL' in incoming()) || incoming().photoURL == null || incoming().photoURL is string);
    }
    function isValidJoinRequestUserUpdate(userId) {
      return request.auth.uid == userId &&
             incoming().uid == userId &&
             incoming().status == 'pending' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
    }
    function isValidJoinRequestAdminReview(leagueId) {
      return isLeagueAdmin(leagueId) &&
             existing().status == 'pending' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'approvedAt', 'rejectedAt', 'updatedAt']) &&
             incoming().reviewedBy == request.auth.uid &&
             incoming().status in ['approved', 'rejected'];
    }

    match /leagues/{leagueId} {
      allow get: if isSignedIn() && (debugMode() || isLeagueMemberData(resource.data));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidLeague(incoming()) && incoming().adminId == request.auth.uid;
      allow update: if isSignedIn() && (
        (debugMode()) ||
        (isLeagueAdmin(leagueId) && incoming().diff(existing()).affectedKeys().hasAny(['status', 'draftOrder', 'currentTurnIndex', 'participants'])) ||
        isSelfJoinParticipantsUpdate() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['currentTurnIndex']))
      );
    }

    match /leagues/{leagueId}/joinRequests/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isLeagueAdmin(leagueId));
      allow list: if isSignedIn() && isLeagueAdmin(leagueId);
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    !isLeagueMember(leagueId) &&
                    isValidJoinRequestCreate(userId);
      allow update: if isSignedIn() && (
                    (isValidJoinRequestUserUpdate(userId)) ||
                    (isValidJoinRequestAdminReview(leagueId))
                  );
      allow delete: if false;
    }

    // Picks
    function isValidPick(data) {
      return data.keys().hasAll(['userId', 'teamIds']) &&
             data.userId == request.auth.uid &&
             data.teamIds is list && data.teamIds.size() <= 4;
    }

    match /leagues/{leagueId}/picks/{userId} {
      allow read: if isSignedIn() && (debugMode() || isLeagueMember(leagueId));
      allow create, update: if isSignedIn() && 
                             (debugMode() ||
                             request.auth.uid == userId && 
                             isValidPick(incoming()) &&
                             isLeagueMember(leagueId));
    }

    // Match Results (Global)
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (debugMode() || incoming().adminId == request.auth.uid);
      allow update, delete: if isSignedIn() && (debugMode() || existing().adminId == request.auth.uid);
    }
  }
}
